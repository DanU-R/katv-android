<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash sesingkat mungkin: obsidian polos tanpa ikon.
         Ikon + wordmark KaTv ditampilkan penuh oleh Compose SplashScreen. -->
    <style name="AppTheme" parent="@style/SplashThemeBase">
        <item name="android:windowSplashScreenBackground">@color/katv_obsidian</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>
</resources>
